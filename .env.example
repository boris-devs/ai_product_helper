# --- OpenRouter (https://openrouter.ai/keys) ---
# Вставьте свой ключ и модель. Файл .env в .gitignore и не попадает в репозиторий.
OPENROUTER_API_KEY=
# Например: anthropic/claude-sonnet-4.5, openai/gpt-4o-mini, google/gemini-2.5-flash
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Параметры генерации ---
LLM_TEMPERATURE=0.2
# Лимит токенов ответа. Для моделей с рассуждениями (reasoning) ставьте больше, иначе ответ придёт пустым
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
# Повторы запроса при сетевых ошибках, 429 и 5xx
LLM_MAX_RETRIES=2
# Передавать response_format=json_object (отключите, если модель его не поддерживает)
LLM_JSON_MODE=true
# Сколько раз модели можно исправить ответ, не прошедший проверку (длина, выдуманные числа)
GENERATION_MAX_ATTEMPTS=2

# --- Логирование (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=product_helper
# Для запуска через docker compose хост переопределяется на "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
